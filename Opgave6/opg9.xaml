<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Opgave6.opg9">
    <ContentPage.Content>
        <HorizontalStackLayout Spacing="20">
            <VerticalStackLayout Spacing="20">
                <Entry x:Name="E1"/>
                <Button Text="Add" HorizontalOptions="Start"/>
                <Picker x:Name="p1" HeightRequest="200" WidthRequest="200"/>
                <Button Text="Clear" HorizontalOptions="Center"/>
            </VerticalStackLayout>
            <VerticalStackLayout Spacing="20" VerticalOptions="Center">
                <Button Text="==>" />
                <Button Text="&lt;=="/>
            </VerticalStackLayout>
            <VerticalStackLayout Spacing="20">
                <Entry x:Name="E2"/>
                <Button Text="Add" HorizontalOptions="Start"/>
                <Picker x:Name="p2" HeightRequest="200" WidthRequest="200"/>
                <Button Text="Clear" HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </HorizontalStackLayout>
    </ContentPage.Content>
</ContentPage>