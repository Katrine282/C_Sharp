@using DTO
@model List<DTO.Studerende>

<h2>Studerende</h2>

<a href="/Studerende/Create">Opret ny</a>

<table border="1">
    <tr>
        <th>Navn</th>
        <th>Alder</th>
        <th>Karakter</th>
        <th>Start</th>
        <th>Type</th>
        <th>Hold</th>
        <th>Handling</th>
    </tr>

    @foreach (var s in Model)
    {
        <tr>
            <td>@s.Navn</td>
            <td>@s.Alder</td>
            <td>@s.Karakter</td>
            <td>@s.Studiestart.ToLongDateString()</td>
            <td>@s.Studietype</td>
            <td>@s.HoldId</td>
            <td>
                <a href="/Studerende/Details/@s.ID">Se</a> |
                @* <a href="/Studerende/Edit/@s.ID">Rediger</a> | *@
                <a href="/Studerende/Delete/@s.ID">Slet</a>
            </td>
        </tr>
    }
</table>