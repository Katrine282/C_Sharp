<h2>Tilføj studerende til hold</h2>

<form asp-action="AddStuderende" asp-route-holdId="@ViewBag.HoldId" method="post">

    <select name="studId">
        @foreach (var s in ViewBag.Studerende)
        {
            <option value="@s.ID">@s.Navn</option>
        }
    </select>

    <button type="submit">Tilføj</button>
</form>