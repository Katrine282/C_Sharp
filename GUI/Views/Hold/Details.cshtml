@model DTO.Hold

<h2>@Model.Navn</h2>

<a asp-action="AddStuderende" asp-route-holdId="@Model.HoldId">Tilføj studerende</a>

<table border="1">
    <tr>
        <th>Navn</th>
        <th>Alder</th>
    </tr>

    @foreach (var s in ViewBag.Studerende)
    {
        <tr>
            <td>@s.Navn</td>
            <td>@s.Alder</td>
        </tr>
    }
</table>

<form method="post" action="/Hold/GivKarakter">
    <input type="hidden" name="holdId" value="@Model.HoldId" />
    <button type="submit">Giv karakter til hold</button>
</form>